from typing import Any
from pydantic import ValidationError

from gps_time import GPSTime

from api.schemas import RawObservationParsed, StationSetupParsed
from services.parsers.parser_base import ParserBase


def safe_get(columns: list[str], index: int) -> str | None:
    """Obtiene el valor de la columna de forma segura. Si está vacía o fuera de rango, devuelve None."""
    if index < len(columns):
        val = columns[index].strip()
        return val if val else None
    return None


class GkaParser(ParserBase):
    """Parsea archivos GKA. Extrae configuraciones de estacionamientos y observaciones."""

    def _parse_station_setup(self, columns: list[str]) -> StationSetupParsed:
        # Pydantic convertirá los strings a float automáticamente o levantará un ValidationError
        return StationSetupParsed(
            station_name=safe_get(columns, 1),
            station_height=safe_get(columns, 5),
            edm_refractive_index=safe_get(columns, 11),
            edm_carrier_wavelength=safe_get(columns, 12),
        )

    def _parse_raw_observation(self, columns: list[str]) -> RawObservationParsed:
        gps_week_str = safe_get(columns, 2)
        gps_tow_str = safe_get(columns, 4)
        
        obs_time = None
        if gps_week_str and gps_tow_str:
            # Castear primero a float evita ValueError si el string tiene decimales
            obs_time = GPSTime(
                week_number=int(float(gps_week_str)),
                time_of_week=float(gps_tow_str)
            ).to_datetime()

        return RawObservationParsed(
            target_number=safe_get(columns, 0),
            target_name=safe_get(columns, 1),
            circle=safe_get(columns, 6),
            hz_angle=safe_get(columns, 10),
            v_angle=safe_get(columns, 12),
            distance_geom=safe_get(columns, 7),
            observation_time=obs_time,
            prism_constant=safe_get(columns, 15),
            target_height=safe_get(columns, 9),
            temperature=safe_get(columns, 26),
            pressure=safe_get(columns, 25),
            refraction_coef=safe_get(columns, 16),
            std_dev_hz=safe_get(columns, 11),
            std_dev_v=safe_get(columns, 13),
            std_dev_dist=safe_get(columns, 8),
        )

    def parse(self) -> list[dict]:
        """Parsea el archivo GKA y devuelve una lista de diccionarios."""
        parsed_data: list[dict[str, Any]] = []
        current_observations: list[RawObservationParsed] = []
        current_station: StationSetupParsed | None = None
        is_new_station = False

        for line_idx, line in enumerate(self.lines, start=1):
            line = line.strip()
            if not line or line.startswith(";"):
                continue

            if line.startswith("#GNV11"):
                if current_station is not None:
                    parsed_data.append(
                        {
                            "station": current_station,
                            "observations": current_observations,
                        }
                    )
                is_new_station = True
                current_station = None
                current_observations = []
                continue

            if line.startswith("#END11"):
                is_new_station = False
                continue

            columns = line.split(",")

            try:
                if is_new_station:
                    if len(columns) >= 2:
                        current_station = self._parse_station_setup(columns)
                        is_new_station = False
                        continue

                # Confirmamos que al menos es una línea densa antes de procesar
                if current_station is not None and len(columns) >= 10:
                    raw_observation = self._parse_raw_observation(columns)
                    if raw_observation:
                        current_observations.append(raw_observation)
                        
            except (ValueError, ValidationError) as e:
                # Enriquecemos la traza sin ahogar el error original para el enrutador
                raise ValueError(f"Error parseando archivo GKA en la línea {line_idx}:\n{str(e)}")

        if current_station is not None:
            parsed_data.append(
                {"station": current_station, "observations": current_observations}
            )

        return parsed_data
