import hashlib
from datetime import datetime
from services.parsers.gka_parser import GkaParser
from api.schemas import ImportSessionCreate
from sqlalchemy.orm import Session # Si necesitas controlar la transacción aquí

class ImportOrchestratorService:
    def __init__(
        self, 
        session: Session, # Para controlar la transacción general
        import_repo: ImportSessionRepository,
        station_repo: StationSetupRepository,
        obs_repo: RawObservationRepository
    ):
        self.session = session
        self.import_repo = import_repo
        self.station_repo = station_repo
        self.obs_repo = obs_repo

    def process_gka_import(self, project_id: int, filename: str, file_content: str):
        # 1. Parsear el archivo (Ocurre 100% en memoria)
        parser = GkaParser(file_content)
        parsed_data = parser.parse() # Devuelve list[dict]
        
        # 2. Generar Hash y Crear ImportSession
        content_hash = hashlib.sha256(file_content.encode('utf-8')).hexdigest()
        
        # Validar si ya existe
        if self.import_repo.get_by_project_and_hash(project_id, content_hash):
            raise ValueError("Este archivo ya ha sido importado.")

        try:
            # Iniciamos bloque transaccional lógico
            
            # Crear Session de Importación (sin commit automático si es posible)
            import_session = self.import_repo.create_no_commit({
                "project_id": project_id,
                "filename": filename,
                "content_hash": content_hash,
                "import_date": datetime.now()
            })
            
            self.session.flush() # Para obtener el ID de la import_session

            # 3. Iterar sobre los datos parseados para preparar la inserción
            for block in parsed_data:
                station_parsed = block["station"]
                obs_list = block["observations"]
                
                # Crear StationSetup
                station_dict = station_parsed.model_dump()
                station_dict["import_session_id"] = import_session.id
                station = self.station_repo.create_no_commit(station_dict)
                self.session.flush() # Para obtener el ID del estacionamiento
                
                # Preparar las observaciones para este estacionamiento
                obs_to_insert = []
                for obs in obs_list:
                    obs_dict = obs.model_dump()
                    obs_dict["station_setup_id"] = station.id
                    obs_to_insert.append(obs_dict)
                
                # Insertar observaciones masivamente (Bulk Insert)
                self.obs_repo.bulk_create_no_commit(obs_to_insert)

            # 4. Si todo ha ido bien hasta aquí, hacemos el COMMIT
            self.session.commit()
            
            # Devolver el resultado (mapeado a Pydantic)
            return import_session
            
        except Exception as e:
            # Si algo falla (parseo posterior, base de datos, etc) revertimos TODO
            self.session.rollback()
            raise ValueError(f"Error procesando la importación: {str(e)}")

